# Editor settings that match the linters (ADR 0007 S17). Advisory: no tool reads this file in CI. The formatters
# (terraform fmt, ruff format) and the end-of-file-fixer hook enforce the same rules for their own files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
