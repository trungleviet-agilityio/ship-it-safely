rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ir_apply" target="ibucket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ie12" value="apply saved plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.53;entryDx=0;entryDy=0;" edge="1" parent="1" source="ir_apply" target="istack"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a" name="App pipeline"><mxGraphModel dx="1920" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1920" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="abg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="900" as="geometry"/></mxCell><mxCell id="atitle" value="&lt;b&gt;ship-it-safely: ci-cd: app pipeline (app-ci, app-deploy)&lt;/b&gt;&lt;br&gt;Based on d39b84c | 2026-10-27" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="50" as="geometry"/></mxCell><mxCell id="alegend" value='&lt;b&gt;Edges&lt;/b&gt;&lt;br&gt;Solid: calls and data flow&lt;br&gt;&lt;font color="#DD344C"&gt;Red dashed&lt;/font&gt;: OIDC assume role' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;strokeColor=#D5DBDB;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="76" as="geometry"/></mxCell><mxCell id="adev" value="Developer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="81" y="251" width="78" height="78" as="geometry"/></mxCell><mxCell id="agh" value="GitHub Actions: app-ci.yml, app-deploy.yml" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292F;fontColor=#24292F;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="220" y="200" width="860" height="600" as="geometry"/></mxCell><mxCell id="aj_ci" value="app-ci on PR (app/**), no AWS&lt;br&gt;hadolint, build (unit tests in the build),&lt;br&gt;Fargate-like smoke, Trivy gate, never pushes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="420" height="80" as="geometry"/></mxCell><mxCell id="aj_build" value="build-scan, push to main&lt;br&gt;no OIDC, no environment,&lt;br&gt;no secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="aart" value="artifact app-image&lt;br&gt;image tar + sha256&lt;br&gt;1-day retention" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#545B64;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="aj_deploy" value="deploy, environment dev&lt;br&gt;your approval, verify&lt;br&gt;sha256, docker load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="aguard" value="&lt;b&gt;Every workflow&lt;/b&gt;: actions pinned by SHA, tools checksum-verified, harden-runner first (block mode with an exact egress allowlist on deploy), permissions: {} with id-token: write only on deploy. repo-guard on every PR and push: zizmor, gitleaks, account-ID guard, trigger allowlist." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#D5DBDB;rounded=1;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="780" height="90" as="geometry"/></mxCell><mxCell id="acloud" value="AWS Cloud" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="740" height="700" as="geometry"/></mxCell><mxCell id="aacct" value="Dev account (sis-dev), ap-southeast-1" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="acloud"><mxGeometry x="20" y="40" width="700" height="640" as="geometry"/></mxCell><mxCell id="asecret" value="Secrets Manager&lt;br&gt;sis/dev/app-api-key" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="aacct"><mxGeometry x="40" y="91" width="78" height="78" as="geometry"/></mxCell><mxCell id="ar_deploy" value="IAM role&lt;br&gt;sis-dev-gha-deploy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="aacct"><mxGeometry x="40" y="291" width="78" height="78" as="geometry"/></mxCell><mxCell id="aecr" value="ECR repository&lt;br&gt;sis-dev-app" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.registry;" vertex="1" parent="aacct"><mxGeometry x="220" y="291" width="78" height="78" as="geometry"/></mxCell><mxCell id="atd" value="Task definition&lt;br&gt;new revision" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecs_task;" vertex="1" parent="aacct"><mxGeometry x="400" y="291" width="78" height="78" as="geometry"/></mxCell><mxCell id="asvc" value="ECS service&lt;br&gt;sis-dev-app" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecs_service;" vertex="1" parent="aacct"><mxGeometry x="580" y="291" width="78" height="78" as="geometry"/></mxCell><mxCell id="asteps" value="&lt;b&gt;deploy job, in order&lt;/b&gt;&lt;br&gt;1. Preflight: the stack is up and the secret has an AWSCURRENT value (DescribeSecret only)&lt;br&gt;2. Push once with the git SHA tag (immutable), read the digest&lt;br&gt;3. Copy the task definition Terraform registered, swap only image to repo@digest, validate the hardened shape, register&lt;br&gt;4. update-service to that revision, wait until the rollout is COMPLETED; a circuit-breaker rollback fails the run" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#D5DBDB;rounded=1;" vertex="1" parent="aacct"><mxGeometry x="40" y="480" width="640" height="130" as="geometry"/></mxCell><mxCell id="ae1" value="PR (app/**)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adev" target="aj_ci"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae2" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aj_build" target="aart"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae3" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aart" target="aj_deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae4" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;dashed=1;strokeColor=#DD344C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aj_deploy" target="ar_deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae5" value="1 check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLo