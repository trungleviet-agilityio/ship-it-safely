top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="esubnet"><mxGeometry x="80" y="181" width="78" height="78" as="geometry"/></mxCell><mxCell id="etask" value="Fargate task (ECS service&lt;br&gt;sis-dev-app), 0.25 vCPU,&lt;br&gt;0.5 GB, UID 10001,&lt;br&gt;read-only root" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecs_task;" vertex="1" parent="esubnet"><mxGeometry x="360" y="181" width="78" height="78" as="geometry"/></mxCell><mxCell id="eexec" value="IAM role&lt;br&gt;sis-dev-ecs-exec" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;" vertex="1" parent="eacct"><mxGeometry x="960" y="301" width="78" height="78" as="geometry"/></mxCell><mxCell id="eecr" value="ECR repository&lt;br&gt;sis-dev-app" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.registry;" vertex="1" parent="eacct"><mxGeometry x="1150" y="101" width="78" height="78" as="geometry"/></mxCell><mxCell id="esecret" value="Secrets Manager&lt;br&gt;sis/dev/app-api-key" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="eacct"><mxGeometry x="1150" y="301" width="78" height="78" as="geometry"/></mxCell><mxCell id="elogs" value="CloudWatch Logs&lt;br&gt;/ecs/sis-dev-app, 7 days" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="eacct"><mxGeometry x="1150" y="501" width="78" height="78" as="geometry"/></mxCell><mxCell id="esg" value="&lt;b&gt;Security groups&lt;/b&gt;&lt;br&gt;ALB: in TCP 80 from alb_ingress_cidrs (default 0.0.0.0/0), out container port to the task group only.&lt;br&gt;Task: in 8080 from the ALB group only, out TCP 443 (ECR, Secrets Manager, Logs over its public IP)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#D5DBDB;rounded=1;" vertex="1" parent="eacct"><mxGeometry x="40" y="650" width="560" height="110" as="geometry"/></mxCell><mxCell id="esvcnote" value="&lt;b&gt;Service and task&lt;/b&gt;&lt;br&gt;ROLLING, min 100%, max 200%, circuit breaker with rollback; ECS Exec off. Health check /health. The task role has no permissions (the app makes no AWS calls). Terraform creates only the secret shell; you set the value out of band." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#D5DBDB;rounded=1;" vertex="1" parent="eacct"><mxGeometry x="640" y="650" width="600" height="110" as="geometry"/></mxCell><mxCell id="ee1" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eusers" target="eigw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ee2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#545B64;